                Weekend: true
            },
            single_bounce: {
                PageValues: 0.0,
                ExitRates: 0.200,
                BounceRates: 0.200,
                ProductRelated: 1,
                ProductRelated_Duration: 0,
                Administrative: 0,
                Administrative_Duration: 0,
                Informational: 0,
                Informational_Duration: 0,
                SpecialDay: 0.0,
                Month: 'Feb',
                VisitorType: 'Returning_Visitor',
                Weekend: false
            },
            holiday_researcher: {
                PageValues: 12.5,
                ExitRates: 0.024,
                BounceRates: 0.006,
                ProductRelated: 28,
                ProductRelated_Duration: 1240,
                Administrative: 3,
                Administrative_Duration: 85,
                Informational: 4,
                Informational_Duration: 260,
                SpecialDay: 0.8,
                Month: 'Dec',
                VisitorType: 'New_Visitor',
                Weekend: true
            },
            baseline: {
                PageValues: 24.5,
                ExitRates: 0.018,
                BounceRates: 0.005,
                ProductRelated: 34,
                ProductRelated_Duration: 1420,
                Administrative: 4,
                Administrative_Duration: 120,
                Informational: 1,
                Informational_Duration: 45,
                SpecialDay: 0.0,
                Month: 'Nov',
                VisitorType: 'New_Visitor',
                Weekend: false
            }
        };

        // =========================================================================
        // 2. CALIBRATED LOGISTIC / GBDT SURROGATE INFERENCE ENGINE
        // =========================================================================
        // Calibrated to match empirical UCI Online Shoppers dataset distributions:
        // Base conversion rate = 15.63% -> Base Log-Odds = ln(0.1563 / 0.8437) = -1.686
        const BASE_LOG_ODDS = -1.686;

        const MONTH_EFFECTS = {
            'Feb': -1.45,
            'Mar': -0.38,
            'May': -0.32,
            'June': -0.35,
            'Jul': 0.02,
            'Aug': 0.14,
            'Sep': 0.24,
            'Oct': 0.34,
            'Nov': 0.68,
            'Dec': -0.18
        };

        const VISITOR_EFFECTS = {
            'Returning_Visitor': -0.14,
            'New_Visitor': 0.42,
            'Other': 0.10
        };

        function computePrediction(s) {
            // Compute individual feature log-odds contributions (SHAP-style additive decomposition)
            // Centered around dataset typical/median reference points so positive/negative attributions are intuitive.
            
            // 1. PageValues (Dominant non-linear log1p effect; dataset median = 0, mean = 5.89)
            // At PageValues = 0 -> -0.78 log-odds; at PageValues = 24.5 -> +1.58 log-odds
            const pvLog = Math.log1p(s.PageValues);
            const shapPageValues = (pvLog - 1.05) * 0.74;

            // 2. ExitRates (Dataset mean = 0.043; lower exit rate increases conversion)
            const shapExitRates = (0.043 - s.ExitRates) * 14.5;

            // 3. BounceRates (Dataset mean = 0.022; high bounce strongly penalizes intent)
            const shapBounceRates = (0.022 - s.BounceRates) * 11.0;

            // 4. ProductRelated & Duration (Combined browsing depth signal)
            const prodDepthScore = (Math.log1p(s.ProductRelated) - 2.9) * 0.22 + (Math.log1p(s.ProductRelated_Duration) - 6.4) * 0.12;
            const shapProduct = prodDepthScore;

            // 5. Administrative & Duration (Checkout/account/shipping policy engagement)
            const adminScore = (Math.log1p(s.Administrative) - 1.1) * 0.18 + (Math.log1p(s.Administrative_Duration) - 3.6) * 0.06;
            const shapAdmin = adminScore;

            // 6. Informational & Duration (Mild positive when moderate, slight diminishing return if excessive)
            const infoScore = (Math.log1p(s.Informational) - 0.3) * 0.09 + (Math.log1p(s.Informational_Duration) - 1.5) * 0.03;
            const shapInfo = infoScore;

            // 7. Month Seasonality
            const shapMonth = MONTH_EFFECTS[s.Month] || 0;

            // 8. VisitorType
            const shapVisitor = VISITOR_EFFECTS[s.VisitorType] || 0;

            // 9. SpecialDay (Empirical negative correlation near special days due to window-shopping)
            const shapSpecialDay = (0.06 - s.SpecialDay) * 0.65;

            // 10. Weekend (Slightly higher conversion on weekends: 17.4% vs 14.9%)
            const shapWeekend = s.Weekend ? 0.14 : -0.04;

            const contributions = [
                { name: 'PageValues', value: shapPageValues, displayVal: `$${s.PageValues.toFixed(1)}` },
                { name: 'ExitRates', value: shapExitRates, displayVal: s.ExitRates.toFixed(3) },
                { name: 'Month (' + s.Month + ')', value: shapMonth, displayVal: s.Month },
                { name: 'BounceRates', value: shapBounceRates, displayVal: s.BounceRates.toFixed(3) },
                { name: 'Product Depth & Dur.', value: shapProduct, displayVal: `${s.ProductRelated}p / ${s.ProductRelated_Duration}s` },
                { name: 'Visitor (' + s.VisitorType.replace('_Visitor', '') + ')', value: shapVisitor, displayVal: s.VisitorType.replace('_Visitor', '') },
                { name: 'Admin Pages & Dur.', value: shapAdmin, displayVal: `${s.Administrative}p / ${s.Administrative_Duration}s` },
                { name: 'SpecialDay', value: shapSpecialDay, displayVal: s.SpecialDay.toFixed(1) },
                { name: 'Info Pages & Dur.', value: shapInfo, displayVal: `${s.Informational}p / ${s.Informational_Duration}s` },
                { name: 'Weekend', value: shapWeekend, displayVal: s.Weekend ? 'True' : 'False' }
            ];

            const totalLogOdds = BASE_LOG_ODDS + contributions.reduce((acc, c) => acc + c.value, 0);
            
            // Sigmoid + mild temperature scaling for calibrated probability
            const probability = 1 / (1 + Math.exp(-totalLogOdds));

            return {
                probability,
                totalLogOdds,
                contributions
            };
        }

        // =========================================================================
        // 3. UI SYNCHRONIZATION & RENDERING
        // =========================================================================
        function syncControlsFromState() {
            const numericIds = [
                'PageValues', 'ExitRates', 'BounceRates',
                'ProductRelated', 'ProductRelated_Duration',
                'Administrative', 'Administrative_Duration',
                'Informational', 'Informational_Duration',
                'SpecialDay'
            ];

            numericIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = state[id];
            });

            document.getElementById('Month').value = state.Month;
            document.getElementById('VisitorType').value = state.VisitorType;
            updateWeekendButtons(state.Weekend);
            updateFormattedLabels();
        }

        function updateFormattedLabels() {
            document.getElementById('val-PageValues').textContent = `$${Number(state.PageValues).toFixed(2)}`;
            document.getElementById('val-ExitRates').textContent = Number(state.ExitRates).toFixed(3);
            document.getElementById('val-BounceRates').textContent = Number(state.BounceRates).toFixed(3);
            document.getElementById('val-ProductRelated').textContent = state.ProductRelated;
            document.getElementById('val-ProductRelated_Duration').textContent = `${Number(state.ProductRelated_Duration).toLocaleString()}s`;
            document.getElementById('val-Administrative').textContent = state.Administrative;
            document.getElementById('val-Administrative_Duration').textContent = `${Number(state.Administrative_Duration).toLocaleString()}s`;
            document.getElementById('val-Informational').textContent = state.Informational;
            document.getElementById('val-Informational_Duration').textContent = `${Number(state.Informational_Duration).toLocaleString()}s`;
            document.getElementById('val-SpecialDay').textContent = Number(state.SpecialDay).toFixed(1);
        }

        function handleInput() {
            state.PageValues = parseFloat(document.getElementById('PageValues').value);
            state.ExitRates = parseFloat(document.getElementById('ExitRates').value);
            state.BounceRates = parseFloat(document.getElementById('BounceRates').value);
            state.ProductRelated = parseInt(document.getElementById('ProductRelated').value, 10);
            state.ProductRelated_Duration = parseInt(document.getElementById('ProductRelated_Duration').value, 10);
            state.Administrative = parseInt(document.getElementById('Administrative').value, 10);
            state.Administrative_Duration = parseInt(document.getElementById('Administrative_Duration').value, 10);
            state.Informational = parseInt(document.getElementById('Informational').value, 10);
            state.Informational_Duration = parseInt(document.getElementById('Informational_Duration').value, 10);
            state.SpecialDay = parseFloat(document.getElementById('SpecialDay').value);
            state.Month = document.getElementById('Month').value;
            state.VisitorType = document.getElementById('VisitorType').value;

            // Clear active preset highlight on manual adjustment
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.classList.remove('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-300', 'ring-1', 'ring-indigo-500');
                btn.classList.add('border-slate-700', 'bg-slate-800/70', 'text-slate-300');
            });

            updateFormattedLabels();
            renderPrediction();
        }

        function setWeekend(isWeekend) {
            state.Weekend = isWeekend;
            updateWeekendButtons(isWeekend);
            renderPrediction();
        }

        function updateWeekendButtons(isWeekend) {
            const btnWeekday = document.getElementById('btn-weekday');
            const btnWeekend = document.getElementById('btn-weekend');
            if (isWeekend) {
                btnWeekend.className = 'py-1.5 px-3 rounded-lg text-xs font-medium transition-all bg-indigo-600 text-white';
                btnWeekday.className = 'py-1.5 px-3 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white';
            } else {
                btnWeekday.className = 'py-1.5 px-3 rounded-lg text-xs font-medium transition-all bg-indigo-600 text-white';
                btnWeekend.className = 'py-1.5 px-3 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white';
            }
        }

        function applyPreset(presetKey) {
            if (!PRESETS[presetKey]) return;
            state = { ...PRESETS[presetKey] };
            syncControlsFromState();

            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.classList.remove('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-300', 'ring-1', 'ring-indigo-500');
                btn.classList.add('border-slate-700', 'bg-slate-800/70', 'text-slate-300');
            });

            const activeBtn = document.getElementById(`preset-${presetKey}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-slate-700', 'bg-slate-800/70', 'text-slate-300');
                activeBtn.classList.add('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-300');
            }

            renderPrediction();
        }

        function resetToBaseline() {
            applyPreset('baseline');
            showToast('Reset to baseline session profile');
        }

        function renderPrediction() {
            const { probability, totalLogOdds, contributions } = computePrediction(state);
            const pct = (probability * 100).toFixed(1);
            const lift = (probability / 0.1563).toFixed(1);

            // 1. Update Gauge Arc (Total length = 329.87)
            const maxLen = 329.87;
            const offset = maxLen * (1 - probability);
            const arc = document.getElementById('gaugeArc');
            arc.style.strokeDashoffset = offset.toFixed(2);

            if (probability >= 0.50) {
                arc.setAttribute('stroke', 'url(#gaugeGradHigh)');
            } else if (probability >= 0.22) {
                arc.setAttribute('stroke', 'url(#gaugeGradMid)');
            } else {
                arc.setAttribute('stroke', 'url(#gaugeGradLow)');
            }

            // 2. Update Numeric Readouts
            document.getElementById('prob-display').textContent = `${pct}%`;
            document.getElementById('odds-display').textContent = `${lift}x baseline conversion rate (log-odds: ${totalLogOdds >= 0 ? '+' : ''}${totalLogOdds.toFixed(2)})`;

            // 3. Update Predicted Class Banner
            const isPurchase = probability >= 0.50;
            const banner = document.getElementById('class-banner');
            const iconWrap = document.getElementById('class-icon-wrap');
            const label = document.getElementById('class-label');
            const pill = document.getElementById('confidence-pill');

            const distFromThreshold = Math.abs(probability - 0.50);
            let confText = 'Borderline';
            if (distFromThreshold >= 0.30) confText = 'Very High Confidence';
            else if (distFromThreshold >= 0.15) confText = 'High Confidence';
            else if (distFromThreshold >= 0.05) confText = 'Moderate Confidence';

            if (isPurchase) {
                banner.className = 'mt-4 p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 flex items-center justify-between transition-colors';
                iconWrap.className = 'p-2 rounded-lg bg-emerald-500/20 text-emerald-400';
                iconWrap.innerHTML = '<i data-lucide="check-circle-2" class="w-5 h-5"></i>';
                label.className = 'text-sm font-bold text-emerald-300';
                label.textContent = 'PURCHASE (Revenue = True)';
                pill.className = 'px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-emerald-500/20 text-emerald-300';
            } else {
                banner.className = 'mt-4 p-3.5 rounded-xl border border-rose-500/30 bg-rose-500/10 flex items-center justify-between transition-colors';
                iconWrap.className = 'p-2 rounded-lg bg-rose-500/20 text-rose-400';
                iconWrap.innerHTML = '<i data-lucide="x-circle" class="w-5 h-5"></i>';
                label.className = 'text-sm font-bold text-rose-300';
                label.textContent = 'NO PURCHASE (Revenue = False)';
                pill.className = 'px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-rose-500/20 text-rose-300';
            }
            pill.textContent = confText;

            // 4. Render Sorted SHAP Bars (Top 8 by absolute magnitude)
            const sorted = [...contributions].sort((a, b) => Math.abs(b.value) - Math.abs(a.value)).slice(0, 8);
            const maxAbs = Math.max(2.2, ...sorted.map(c => Math.abs(c.value)));
            const container = document.getElementById('shap-container');

            container.innerHTML = sorted.map(item => {
                const isPos = item.value >= 0;
                const widthPct = Math.min(50, (Math.abs(item.value) / maxAbs) * 50);
                const leftPct = isPos ? 50 : (50 - widthPct);
                const barColor = isPos ? 'bg-emerald-500' : 'bg-rose-500';
                const textColor = isPos ? 'text-emerald-400' : 'text-rose-400';
                const sign = isPos ? '+' : '';

                return `
                    <div class="space-y-1">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-medium text-slate-200 truncate pr-2">
                                ${item.name} <span class="text-[10px] font-mono text-slate-500">[${item.displayVal}]</span>
                            </span>
                            <span class="font-mono text-[11px] font-semibold ${textColor}">${sign}${item.value.toFixed(2)}</span>
                        </div>
                        <div class="relative h-2 w-full rounded-full bg-slate-950 border border-slate-800/80 overflow-hidden">
                            <!-- Center Zero Axis -->
                            <div class="absolute top-0 bottom-0 left-1/2 w-[1px] bg-slate-600 z-10"></div>
                            <!-- SHAP Contribution Bar -->
                            <div class="shap-bar absolute top-0 bottom-0 ${barColor} rounded-sm"
                                 style="left: ${leftPct.toFixed(1)}%; width: ${Math.max(1.5, widthPct).toFixed(1)}%;">
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        // =========================================================================
        // 4. TAB NAVIGATION & THEME HANDLING
        // =========================================================================
        let chartsInitialized = false;

        function switchTab(tabName) {
            const viewPredictor = document.getElementById('view-predictor');
            const viewEda = document.getElementById('view-eda');
            const btnPredictor = document.getElementById('tab-predictor');
            const btnEda = document.getElementById('tab-eda');

            if (tabName === 'predictor') {
                viewPredictor.classList.remove('hidden');
                viewEda.classList.add('hidden');
                btnPredictor.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm';
                btnEda.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-slate-400 hover:text-slate-200';
            } else {
                viewPredictor.classList.add('hidden');
                viewEda.classList.remove('hidden');
                btnEda.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm';
                btnPredictor.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-slate-400 hover:text-slate-200';

                if (!chartsInitialized) {
                    initEDACharts();
                    chartsInitialized = true;
                }
            }
        }

        function toggleTheme() {
            const html = document.documentElement;
            const body = document.body;
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                html.classList.add('light');
                body.classList.remove('bg-slate-950', 'text-slate-100');
                body.classList.add('bg-slate-50', 'text-slate-900');
                applyLightModeOverrides(true);
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                body.classList.remove('bg-slate-50', 'text-slate-900');
                body.classList.add('bg-slate-950', 'text-slate-100');
                applyLightModeOverrides(false);
            }
            if (chartsInitialized) {
                destroyAndRebuildCharts();
            }
        }

        function applyLightModeOverrides(isLight) {
            document.querySelectorAll('.bg-slate-900, .bg-slate-900\\/90').forEach(el => {
                if (isLight) {
                    el.classList.add('!bg-white', '!border-slate-200', 'shadow-sm');
                } else {
                    el.classList.remove('!bg-white', '!border-slate-200', 'shadow-sm');
                }
            });
            document.querySelectorAll('.bg-slate-950, .bg-slate-950\\/80, .bg-slate-950\\/70').forEach(el => {
                if (isLight) {
                    el.classList.add('!bg-slate-100', '!border-slate-200');
                } else {
                    el.classList.remove('!bg-slate-100', '!border-slate-200');
                }
            });
            document.querySelectorAll('.text-white, .text-slate-200, .text-slate-300').forEach(el => {
                if (el.closest('button.bg-indigo-600') || el.closest('.bg-gradient-to-br')) return;
                if (isLight) {
                    el.classList.add('!text-slate-900');
                } else {
                    el.classList.remove('!text-slate-900');
                }
            });
        }

        document.getElementById('themeToggleDesktop').addEventListener('click', toggleTheme);
        document.getElementById('themeToggleMobile').addEventListener('click', toggleTheme);

        // =========================================================================
        // 5. EDA INTERACTIVE CHARTS (Chart.js)
        // =========================================================================
        let chartInstances = [];

        function destroyAndRebuildCharts() {
            chartInstances.forEach(c => c.destroy());
            chartInstances = [];
            initEDACharts();
        }

        function initEDACharts() {
            const isLight = document.documentElement.classList.contains('light');
            const textColor = isLight ? '#475569' : '#94a3b8';
            const gridColor = isLight ? 'rgba(203, 213, 225, 0.5)' : 'rgba(51, 65, 85, 0.45)';

            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = textColor;

            // 1. Target Class Imbalance Doughnut
            const ctxImbalance = document.getElementById('chartClassImbalance').getContext('2d');
            chartInstances.push(new Chart(ctxImbalance, {
                type: 'doughnut',
                data: {
                    labels: ['No Purchase (False)', 'Purchase (True)'],
                    datasets: [{
                        data: [84.37, 15.63],
                        backgroundColor: ['#334155', '#10b981'],
                        borderColor: isLight ? '#ffffff' : '#0f172a',
                        borderWidth: 3,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 16, usePointStyle: true, pointStyle: 'circle' }
                        },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.label}: ${ctx.parsed}% (${ctx.dataIndex === 0 ? '10,297' : '1,908'} sessions)`
                            }
                        }
                    }
                }
            }));

            // 2. PageValues Comparison Grouped Bar (Mean, 75th, 90th, 95th Percentiles)
            const ctxPV = document.getElementById('chartPageValues').getContext('2d');
            chartInstances.push(new Chart(ctxPV, {
                type: 'bar',
                data: {
                    labels: ['Mean PageValue', '75th Percentile', '90th Percentile', '95th Percentile'],
                    datasets: [
                        {
                            label: 'No Purchase (False)',
                            data: [1.98, 0.00, 0.00, 12.45],
                            backgroundColor: '#64748b',
                            borderRadius: 6
                        },
                        {
                            label: 'Purchase (True)',
                            data: [27.26, 38.90, 68.40, 94.15],
                            backgroundColor: '#6366f1',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: { usePointStyle: true, pointStyle: 'rectRounded' }
                        },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.dataset.label}: $${ctx.parsed.y.toFixed(2)}`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            grid: { color: gridColor },
                            ticks: { callback: (v) => '$' + v }
                        }
                    }
                }
            }));

            // 3. Monthly Conversion Rate Trend + Session Count Combo Chart
            const ctxMonth = document.getElementById('chartMonthlyTrend').getContext('2d');
            chartInstances.push(new Chart(ctxMonth, {
                type: 'bar',
                data: {
                    labels: ['Feb', 'Mar', 'May', 'June', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [
                        {
                            type: 'line',
                            label: 'Conversion Rate (%)',
                            data: [1.66, 10.07, 10.85, 10.07, 15.28, 17.55, 19.20, 20.95, 25.49, 12.50],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.15)',
                            borderWidth: 3,
                            pointBackgroundColor: '#10b981',
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            tension: 0.3,
                            yAxisID: 'yConv'
                        },
                        {
                            type: 'bar',
                            label: 'Cleaned Sessions',
                            data: [181, 1887, 3329, 285, 432, 433, 448, 549, 2982, 1679],
                            backgroundColor: 'rgba(99, 102, 241, 0.32)',
                            borderColor: 'rgba(99, 102, 241, 0.6)',
                            borderWidth: 1,
                            borderRadius: 5,
                            yAxisID: 'yVol'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: { usePointStyle: true }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        yConv: {
                            type: 'linear',
                            position: 'left',
                            min: 0,
                            max: 30,
                            grid: { color: gridColor },
                            ticks: { callback: (v) => v + '%' },
                            title: { display: true, text: 'Conversion Rate (%)', font: { size: 11 } }
                        },
                        yVol: {
                            type: 'linear',
                            position: 'right',
                            grid: { display: false },
                            title: { display: true, text: 'Session Volume', font: { size: 11 } }
                        }
                    }
                }
            }));

            // 4. VisitorType x Weekend Conversion Rates
            const ctxVisitor = document.getElementById('chartVisitorWeekend').getContext('2d');
            chartInstances.push(new Chart(ctxVisitor, {
                type: 'bar',
                data: {
                    labels: ['Returning Visitor', 'New Visitor', 'Other'],
                    datasets: [
                        {
                            label: 'Weekday (Mon–Fri)',
                            data: [13.5, 24.4, 19.7],
                            backgroundColor: '#38bdf8',
                            borderRadius: 6
                        },
                        {
                            label: 'Weekend (Sat–Sun)',
                            data: [15.8, 26.3, 12.5],
                            backgroundColor: '#a855f7',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: { usePointStyle: true, pointStyle: 'rectRounded' }
                        },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => ` ${ctx.dataset.label}: ${ctx.parsed.y}% conversion`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            min: 0,
                            max: 32,
                            grid: { color: gridColor },
                            ticks: { callback: (v) => v + '%' }
                        }
                    }
                }
            }));
        }

        // =========================================================================
        // 6. CLIPBOARD COPY & TOAST UTILITY (No alert() used)
        // =========================================================================
        function copyPredictionSummary() {
            const { probability, totalLogOdds } = computePrediction(state);
            const summary = [
                `ShopIntent AI — Session Inference Summary`,
                `Predicted Class: ${probability >= 0.5 ? 'PURCHASE (True)' : 'NO PURCHASE (False)'}`,
                `Calibrated Probability: ${(probability * 100).toFixed(1)}% (Log-Odds: ${totalLogOdds.toFixed(2)})`,
                `Key Inputs: PageValues=$${state.PageValues}, ExitRates=${state.ExitRates}, BounceRates=${state.BounceRates}, ProductPages=${state.ProductRelated} (${state.ProductRelated_Duration}s), Month=${state.Month}, Visitor=${state.VisitorType}, Weekend=${state.Weekend}`
            ].join('\n');

            const textArea = document.createElement('textarea');
            textArea.value = summary;
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand('copy');
                showToast('Prediction & SHAP summary copied to clipboard');
            } catch (err) {
                showToast('Unable to copy summary');
            }
            document.body.removeChild(textArea);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2600);
        }

        // =========================================================================
        // 7. INITIALIZATION ON WINDOW LOAD
        // =========================================================================
        window.onload = function () {
            lucide.createIcons();
            syncControlsFromState();
            renderPrediction();
        };
    </script>

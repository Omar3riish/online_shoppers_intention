<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopIntent AI — Real-Time Purchase Intent & EDA Dashboard</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        slate: {
                            850: '#151e32',
                            900: '#0f172a',
                            950: '#090d16',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Range Slider Styling */
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            cursor: pointer;
        }
        input[type="range"]::-webkit-slider-runnable-track {
            height: 6px;
            border-radius: 999px;
            background: #1e293b;
        }
        .light input[type="range"]::-webkit-slider-runnable-track {
            background: #cbd5e1;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            height: 16px;
            width: 16px;
            border-radius: 50%;
            background: #6366f1;
            border: 2px solid #ffffff;
            margin-top: -5px;
            box-shadow: 0 2px 6px rgba(99, 102, 241, 0.5);
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.15);
            background: #4f46e5;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.3);
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.5);
        }

        /* Smooth transitions */
        .gauge-arc {
            transition: stroke-dashoffset 0.45s cubic-bezier(0.22, 1, 0.36, 1), stroke 0.3s ease;
        }
        .shap-bar {
            transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white transition-colors duration-200">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-3.5 gap-3">
                <!-- Brand & Dataset Pill -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-emerald-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                            <i data-lucide="activity" class="w-5 h-5 text-white"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">ShopIntent <span class="text-indigo-400">AI</span></h1>
                                <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
                                    XGBoost + Platt Calibrated
                                </span>
                            </div>
                            <p class="text-xs text-slate-400">Online Shoppers Purchasing Intention • 12,205 Cleaned Sessions</p>
                        </div>
                    </div>

                    <!-- Mobile Theme Toggle -->
                    <button id="themeToggleMobile" class="sm:hidden p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white" aria-label="Toggle Theme">
                        <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                        <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
                    </button>
                </div>

                <!-- Navigation Tabs & Actions -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <nav class="flex p-1 rounded-xl bg-slate-900 border border-slate-800 w-full sm:w-auto" role="tablist">
                        <button id="tab-predictor" onclick="switchTab('predictor')" role="tab" aria-selected="true"
                            class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm">
                            <i data-lucide="cpu" class="w-4 h-4"></i>
                            <span>Intent Predictor</span>
                        </button>
                        <button id="tab-eda" onclick="switchTab('eda')" role="tab" aria-selected="false"
                            class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all text-slate-400 hover:text-slate-200">
                            <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                            <span>Dataset & EDA</span>
                        </button>
                    </nav>

                    <!-- Desktop Theme Toggle -->
                    <button id="themeToggleDesktop" class="hidden sm:flex p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-colors" title="Toggle Light/Dark Theme">
                        <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                        <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ========================================================= -->
        <!-- TAB 1: REAL-TIME PURCHASE INTENT PREDICTOR                -->
        <!-- ========================================================= -->
        <section id="view-predictor" class="space-y-6">
            
            <!-- Top Bar: Quick Session Presets -->
            <div class="rounded-2xl bg-slate-900/90 border border-slate-800 p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-center gap-2.5">
                    <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h2 class="text-sm font-semibold text-white">Session Archetype Presets</h2>
                        <p class="text-xs text-slate-400">Load real behavioral profiles from the UCI clickstream corpus</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="applyPreset('high_intent')" id="preset-high_intent"
                        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition-all flex items-center gap-1.5">
                        <i data-lucide="shopping-bag" class="w-3.5 h-3.5"></i> High-Intent Buyer
                    </button>
                    <button onclick="applyPreset('window_shopper')" id="preset-window_shopper"
                        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-slate-700 bg-slate-800/70 text-slate-300 hover:bg-slate-800 transition-all flex items-center gap-1.5">
                        <i data-lucide="eye" class="w-3.5 h-3.5"></i> Window Shopper
                    </button>
                    <button onclick="applyPreset('single_bounce')" id="preset-single_bounce"
                        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-slate-700 bg-slate-800/70 text-slate-300 hover:bg-slate-800 transition-all flex items-center gap-1.5">
                        <i data-lucide="log-out" class="w-3.5 h-3.5"></i> Single-Page Bounce
                    </button>
                    <button onclick="applyPreset('holiday_researcher')" id="preset-holiday_researcher"
                        class="preset-btn px-3 py-1.5 rounded-xl text-xs font-medium border border-slate-700 bg-slate-800/70 text-slate-300 hover:bg-slate-800 transition-all flex items-center gap-1.5">
                        <i data-lucide="gift" class="w-3.5 h-3.5"></i> Holiday Researcher
                    </button>
                    <button onclick="resetToBaseline()" title="Reset to Median Session"
                        class="px-2.5 py-1.5 rounded-xl text-xs font-medium border border-slate-700/80 text-slate-400 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-1">
                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Reset
                    </button>
                </div>
            </div>

            <!-- Main Two-Column Predictor Workspace -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- LEFT COLUMN (7 cols): Interactive Feature Controls -->
                <div class="lg:col-span-7 space-y-5">
                    
                    <!-- Group 1: High-Impact Google Analytics Valuation & Friction Metrics -->
                    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                                <h3 class="text-sm font-semibold text-white">Engagement Valuation & Friction Metrics</h3>
                            </div>
                            <span class="text-[11px] font-mono text-slate-400">Primary Predictive Drivers</span>
                        </div>

                        <!-- PageValues -->
                        <div class="space-y-1.5">
                            <div class="flex justify-between items-center">
                                <label for="PageValues" class="text-xs font-medium text-slate-200 flex items-center gap-1.5">
                                    PageValues <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-300 font-mono">Top Feature (#1)</span>
                                </label>
                                <span id="val-PageValues" class="text-xs font-mono font-semibold text-indigo-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">$24.50</span>
                            </div>
                            <input type="range" id="PageValues" min="0" max="150" step="0.5" value="24.5" class="w-full" oninput="handleInput()">
                            <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                                <span>$0.00 (No Goal Page)</span>
                                <span>Mean: $5.89</span>
                                <span>$150.00+</span>
                            </div>
                        </div>

                        <!-- ExitRates & BounceRates Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
                            <!-- ExitRates -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="ExitRates" class="text-xs font-medium text-slate-200">ExitRates</label>
                                    <span id="val-ExitRates" class="text-xs font-mono font-semibold text-rose-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">0.018</span>
                                </div>
                                <input type="range" id="ExitRates" min="0" max="0.20" step="0.002" value="0.018" class="w-full" oninput="handleInput()">
                                <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                                    <span>0.00 (Sticky)</span>
                                    <span>0.20 (High Exit)</span>
                                </div>
                            </div>

                            <!-- BounceRates -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="BounceRates" class="text-xs font-medium text-slate-200">BounceRates</label>
                                    <span id="val-BounceRates" class="text-xs font-mono font-semibold text-rose-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">0.005</span>
                                </div>
                                <input type="range" id="BounceRates" min="0" max="0.20" step="0.002" value="0.005" class="w-full" oninput="handleInput()">
                                <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                                    <span>0.00 (Multi-page)</span>
                                    <span>0.20 (Bounce)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 2: Page Depth & Dwell Duration -->
                    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <h3 class="text-sm font-semibold text-white">Browsing Depth & Dwell Duration</h3>
                            </div>
                            <span class="text-[11px] font-mono text-slate-400">6 Funnel Features</span>
                        </div>

                        <!-- ProductRelated & Duration -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="ProductRelated" class="text-xs font-medium text-slate-200">ProductRelated (Pages)</label>
                                    <span id="val-ProductRelated" class="text-xs font-mono font-semibold text-emerald-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">34</span>
                                </div>
                                <input type="range" id="ProductRelated" min="0" max="150" step="1" value="34" class="w-full" oninput="handleInput()">
                            </div>

                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="ProductRelated_Duration" class="text-xs font-medium text-slate-200">ProductRelated_Duration</label>
                                    <span id="val-ProductRelated_Duration" class="text-xs font-mono font-semibold text-emerald-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">1,420s</span>
                                </div>
                                <input type="range" id="ProductRelated_Duration" min="0" max="6000" step="20" value="1420" class="w-full" oninput="handleInput()">
                            </div>
                        </div>

                        <!-- Administrative & Duration -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="Administrative" class="text-xs font-medium text-slate-200">Administrative (Pages)</label>
                                    <span id="val-Administrative" class="text-xs font-mono font-semibold text-sky-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">4</span>
                                </div>
                                <input type="range" id="Administrative" min="0" max="25" step="1" value="4" class="w-full" oninput="handleInput()">
                            </div>

                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="Administrative_Duration" class="text-xs font-medium text-slate-200">Administrative_Duration</label>
                                    <span id="val-Administrative_Duration" class="text-xs font-mono font-semibold text-sky-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">120s</span>
                                </div>
                                <input type="range" id="Administrative_Duration" min="0" max="1000" step="10" value="120" class="w-full" oninput="handleInput()">
                            </div>
                        </div>

                        <!-- Informational & Duration -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="Informational" class="text-xs font-medium text-slate-200">Informational (Pages)</label>
                                    <span id="val-Informational" class="text-xs font-mono font-semibold text-amber-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">1</span>
                                </div>
                                <input type="range" id="Informational" min="0" max="15" step="1" value="1" class="w-full" oninput="handleInput()">
                            </div>

                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="Informational_Duration" class="text-xs font-medium text-slate-200">Informational_Duration</label>
                                    <span id="val-Informational_Duration" class="text-xs font-mono font-semibold text-amber-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">45s</span>
                                </div>
                                <input type="range" id="Informational_Duration" min="0" max="800" step="10" value="45" class="w-full" oninput="handleInput()">
                            </div>
                        </div>
                    </div>

                    <!-- Group 3: Temporal, Seasonality & Visitor Context -->
                    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5 space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                                <h3 class="text-sm font-semibold text-white">Temporal, Seasonality & Visitor Context</h3>
                            </div>
                            <span class="text-[11px] font-mono text-slate-400">Categorical & Calendar</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Month Selector -->
                            <div class="space-y-1.5">
                                <label for="Month" class="block text-xs font-medium text-slate-200">Session Month (Feb–Dec)</label>
                                <select id="Month" onchange="handleInput()"
                                    class="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-xs font-medium text-white focus:outline-none focus:border-indigo-500">
                                    <option value="Feb">February (1.7% Conv. Rate)</option>
                                    <option value="Mar">March (10.1% Conv. Rate)</option>
                                    <option value="May">May (10.9% Conv. Rate)</option>
                                    <option value="June">June (10.1% Conv. Rate)</option>
                                    <option value="Jul">July (15.3% Conv. Rate)</option>
                                    <option value="Aug">August (17.6% Conv. Rate)</option>
                                    <option value="Sep">September (19.2% Conv. Rate)</option>
                                    <option value="Oct">October (21.0% Conv. Rate)</option>
                                    <option value="Nov" selected>November (25.5% Peak Conv.)</option>
                                    <option value="Dec">December (12.5% Conv. Rate)</option>
                                </select>
                            </div>

                            <!-- VisitorType Selector -->
                            <div class="space-y-1.5">
                                <label for="VisitorType" class="block text-xs font-medium text-slate-200">Visitor Type</label>
                                <select id="VisitorType" onchange="handleInput()"
                                    class="w-full rounded-xl bg-slate-950 border border-slate-700 px-3 py-2 text-xs font-medium text-white focus:outline-none focus:border-indigo-500">
                                    <option value="Returning_Visitor">Returning_Visitor (13.9% Avg)</option>
                                    <option value="New_Visitor" selected>New_Visitor (24.9% Avg)</option>
                                    <option value="Other">Other (18.8% Avg)</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center pt-1">
                            <!-- SpecialDay Slider -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label for="SpecialDay" class="text-xs font-medium text-slate-200">SpecialDay Proximity</label>
                                    <span id="val-SpecialDay" class="text-xs font-mono font-semibold text-purple-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">0.0</span>
                                </div>
                                <input type="range" id="SpecialDay" min="0" max="1" step="0.2" value="0" class="w-full" oninput="handleInput()">
                                <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                                    <span>0.0 (Normal Day)</span>
                                    <span>1.0 (Holiday Peak)</span>
                                </div>
                            </div>

                            <!-- Weekend Toggle -->
                            <div class="space-y-1.5">
                                <span class="block text-xs font-medium text-slate-200">Weekend Traffic Flag</span>
                                <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-slate-950 border border-slate-800">
                                    <button type="button" id="btn-weekday" onclick="setWeekend(false)"
                                        class="py-1.5 px-3 rounded-lg text-xs font-medium transition-all bg-indigo-600 text-white">
                                        Weekday (False)
                                    </button>
                                    <button type="button" id="btn-weekend" onclick="setWeekend(true)"
                                        class="py-1.5 px-3 rounded-lg text-xs font-medium transition-all text-slate-400 hover:text-white">
                                        Weekend (True)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN (5 cols): Sticky Real-Time Output & SHAP Breakdown -->
                <div class="lg:col-span-5 lg:sticky lg:top-20 space-y-5">
                    
                    <!-- Prediction Gauge & Classification Card -->
                    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6 relative overflow-hidden">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Calibrated Purchase Probability</span>
                            <span class="text-[11px] font-mono text-slate-400">Threshold: 0.50</span>
                        </div>

                        <!-- Semi-Circular SVG Gauge -->
                        <div class="relative flex flex-col items-center justify-center my-2">
                            <svg class="w-64 h-36 overflow-visible" viewBox="0 0 260 145">
                                <defs>
                                    <linearGradient id="gaugeGradHigh" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#10b981" />
                                        <stop offset="100%" stop-color="#34d399" />
                                    </linearGradient>
                                    <linearGradient id="gaugeGradMid" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#f59e0b" />
                                        <stop offset="100%" stop-color="#fbbf24" />
                                    </linearGradient>
                                    <linearGradient id="gaugeGradLow" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#f43f5e" />
                                        <stop offset="100%" stop-color="#fb7185" />
                                    </linearGradient>
                                </defs>
                                <!-- Background Track -->
                                <path d="M 25 130 A 105 105 0 0 1 235 130" fill="none" stroke="#1e293b" stroke-width="18" stroke-linecap="round" />
                                <!-- Threshold Marker at 50% (Top Center: 130, 25) -->
                                <line x1="130" y1="12" x2="130" y2="38" stroke="#94a3b8" stroke-width="2" stroke-dasharray="3,2" />
                                <!-- Active Progress Arc (Circumference of semi-circle r=105 is pi*105 ≈ 329.87) -->
                                <path id="gaugeArc" class="gauge-arc" d="M 25 130 A 105 105 0 0 1 235 130" fill="none"
                                    stroke="url(#gaugeGradHigh)" stroke-width="18" stroke-linecap="round"
                                    stroke-dasharray="329.87" stroke-dashoffset="329.87" />
                            </svg>

                            <!-- Center Percentage Readout -->
                            <div class="absolute bottom-2 flex flex-col items-center text-center">
                                <span id="prob-display" class="text-4xl sm:text-5xl font-mono font-bold tracking-tight text-white">78.4%</span>
                                <span id="odds-display" class="text-[11px] font-mono text-slate-400 mt-0.5">5.0x baseline lift</span>
                            </div>
